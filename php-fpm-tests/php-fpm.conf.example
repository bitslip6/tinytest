; Add as a pool configuration in your installed PHP-FPM service.
; REPLACE /absolute/path/to/tinytest, user/group and both token placeholders.
; Create the state directory before starting. Use the SAME service user in both
; pools so 0700 per-run state directories can be shared. Secrets belong in a
; protected config or environment, never a committed production file.

[tinytest-e2e-driver]
user = www-data
group = www-data
listen = /run/php/tinytest-e2e-driver.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 2
pm.max_requests = 1
request_terminate_timeout = 60s
request_terminate_timeout_track_finished = yes
clear_env = yes
env[TINYTEST_FPM_TEST_TOKEN] = REPLACE_WITH_SAME_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
env[TINYTEST_FPM_TEST_WORKER_URL] = http://127.0.0.1:8099/fpm-worker
env[TINYTEST_FPM_TEST_ALLOW_HTTP] = 1
env[TINYTEST_FPM_TEST_STATE] = /var/tmp/tinytest-fpm-tests
env[TINYTEST_FPM_TEST_HARD_SECONDS] = 3
env[TINYTEST_FPM_TEST_ENABLE_HANG] = 1
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[disable_functions] = proc_open,exec,shell_exec,system,passthru,popen

[tinytest-e2e-worker]
user = www-data
group = www-data
listen = /run/php/tinytest-e2e-worker.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 2
pm.max_requests = 1
request_terminate_timeout = 3s
request_terminate_timeout_track_finished = yes
clear_env = yes
env[TINYTEST_FPM_TEST_TOKEN] = REPLACE_WITH_SAME_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
env[TINYTEST_FPM_TEST_STATE] = /var/tmp/tinytest-fpm-tests
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[max_execution_time] = 0
php_admin_value[disable_functions] = proc_open,exec,shell_exec,system,passthru,popen
